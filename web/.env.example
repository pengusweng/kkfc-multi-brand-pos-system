# Base URL of the NestJS API, without a trailing /api: the app adds the /api/... paths itself.
# Read server-side only (Next rewrites and auth route handlers); the browser always calls this app's own /api.
# next.config.ts reads it at build time, so changing it on Vercel needs a redeploy.
#
# Local dev:      http://localhost:3000
# Vercel staging: https://kkfc-demo-api.onrender.com  (set for Production and Preview)
API_URL=http://localhost:3000
