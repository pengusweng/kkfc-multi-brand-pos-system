// Multi-brand POS Operational Schema (6-Week MVP Edition)
// Bounded string lengths follow docs/schema-limits.md.
// Independent UUID primary keys are generated by Prisma with @default(uuid()).
// Shared primary/foreign keys and composite keys reuse the referenced IDs. All refs are inline.
// modified_at requires application or trigger updates; its default only initializes it.

Enum audit_outcomes {
  SUCCESS
  DENIED
  FAILED
}

Enum kitchen_ticket_statuses {
  QUEUED
  ACKNOWLEDGED
  PREPARING
  CHECKING
  REWORKING
  READY
  HANDED_OVER
  CANCELLED
}

Enum order_channels {
  DINE_IN
  TAKEAWAY
  GRABFOOD
  FOODPANDA
}

Enum kitchen_ticket_qc_statuses {
  IN_PROGRESS
  PASSED
  FAILED
}

Enum qc_rejection_reasons {
  INCOMPLETE
}

Enum order_statuses {
  DRAFT
  CONFIRMED
  PREPARING
  REWORKING
  CHECKING
  READY
  COMPLETED
  CANCELLED
}

Enum user_roles {
  SUPERADMIN
  MANAGER
  RECIPE_MANAGER
  SUPERVISOR
  KITCHEN_HEAD
  INVENTORY_STAFF
  KITCHEN_STAFF
  CASHIER_STAFF
}

Enum payment_methods {
  CASH
  E_WALLET          
  CARD              
  PLATFORM_SETTLED
}

Enum payment_statuses {
  UNPAID
  PAID
  REFUNDED
}


// ==========================================
// 1. USERS, RBAC & BRANDS
// ==========================================

// Stores user accounts, credentials, and operational roles, including Superadmin and Owner.
// Employees operate across all brands, subject to role permissions.
// Used to enforce role-based access control across privileged actions, approvals, and confidential recipes (FR-004, FR-029, AC-08).
Table users {
  user_id uuid [pk]
  username varchar(16) [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  password_hash varchar(255) [not null]
  role user_roles [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Optional one-to-one credential; no row means a PIN has not been configured.
Table user_pin_credentials {
  user_id uuid [pk, not null, ref: - users.user_id]
  pin_hash varchar(255) [not null, note: 'Argon2 hash of an exactly four-digit PIN (0-9); validate before hashing and preserve leading zeros. Never store the plaintext PIN.']
  failed_attempts integer [not null, default: 0]
  locked_until timestamp
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Stores revocable sessions. The backend enforces expiration and records activity.
Table user_sessions {
  session_id uuid [pk]
  user_id uuid [not null, ref: > users.user_id]
  token_hash varchar(64) [not null, unique, note: 'SHA-256 hex digest; never store the raw bearer token']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  last_seen_at timestamp [not null, default: `now()`]
  indexes {
    (user_id)
  }
}

// Represents the distinct food brands operating out of the single shared kitchen pilot (2-3 brands for MVP).
// Provides stable brand identities for catalog separation, order tagging, and historical demand tracking (FR-001, FR-024).
Table brands {
  brand_id uuid [pk]
  code char(4) [not null, unique, note: 'Four uppercase letters derived from the brand name on creation and renaming; name-based prefix retained on collision.']
  name varchar(150) [not null]
  logo_url varchar(2048)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// ==========================================
// 2. CATALOG, RECIPES & MODIFIERS
// ==========================================

// Defines versioned recipes for menu items.
// Isolates confidential cooking instructions so method details are never exposed to unauthorized roles (FR-004, FR-020, BR-03).
Table recipes {
  recipe_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  code varchar(64) [not null]
  name varchar(150) [not null]
  serving_description varchar(255)
  instructions varchar(10000) [note: 'Restricted field; exclude from unauthorized API responses (FR-004)']
  notes varchar(2000)
  version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (code, version) [unique]
    (brand_id, is_active)
  }
}

// Stores the sellable food, drink, and bundle configurations offered under each brand catalog.
// Links each sellable product to its active assembly recipe and default price (FR-001, FR-002).
Table menu_items {
  menu_item_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  recipe_id uuid [ref: > recipes.recipe_id]
  img_url varchar(2048) [not null]
  code varchar(64) [unique, not null]
  name varchar(150) [not null]
  description varchar(2000)
  serving_description varchar(255)
  base_price decimal(12,2) [not null]
  is_available boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (brand_id, is_active)
  }
}

// Configures channel-specific pricing and availability controls (Dine-In, Takeaway, GrabFood, foodpanda) for each menu item.
// Allows staff to toggle item availability and apply platform-specific prices during order encoding (FR-003).
Table menu_item_channels {
  menu_item_channel_id uuid [pk]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  order_channel order_channels [not null]
  price decimal(12,2) [not null]
  is_available boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (menu_item_id, order_channel) [unique]
  }
  Note: 'Channel-specific price and availability overrides (FR-003).'
}

// Drop: Enum modifier_component_actions
// Drop: Table modifier_components

// Defines reusable order add-ons, substitutions, or special preparation instructions across the catalog.
Table modifiers {
  modifier_id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  description varchar(2000)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Maps which modifiers are allowed for a specific menu item and defines any item-specific add-on price.
// Restricts staff order entry to valid item-modifier combinations configured for that brand (FR-002, FR-005).
Table menu_item_modifiers {
  menu_item_modifier_id uuid [pk]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  additional_price decimal(12,2) [not null, default: 0]
  is_available boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (menu_item_id, modifier_id) [unique]
  }
}


// ==========================================
// 3. ORDERS & KITCHEN TICKETS
// ==========================================

// Captures staff-entered orders tagged by brand and sales channel, including dine-in table numbers and external delivery platform references.
// Enforces duplicate prevention on external platform orders, tracks order lifecycle timestamps, and preserves cancellation reasons (FR-005, FR-006, FR-008, FR-010, BR-13).
Table orders {
  order_id uuid [pk]
  order_code varchar(64) [not null, note: 'Saved brand prefix and daily number, minimum five digits; repeats on different Manila dates.']
  order_date date [not null, note: 'Asia/Manila calendar date at draft creation.']
  order_number integer [not null]
  brand_id uuid [not null, ref: > brands.brand_id]
  created_by_id uuid [not null, ref: > users.user_id]
  order_channel order_channels [not null]
  merchant_store_reference varchar(255) [note: 'Stable platform store ID or configured store code; null for internal orders']
  external_order_reference varchar(255) [note: 'Platform order ID; null for internal orders']
  table_reference varchar(50)
  status order_statuses [not null, default: 'DRAFT']
  payment_method payment_methods [note: 'Null while DRAFT; set upon confirmation or payment']
  payment_status payment_statuses [not null, default: 'UNPAID']
  payment_reference varchar(255) [note: 'Optional e-wallet/card reference number']
  notes varchar(2000)
  cancelled_by_id uuid [ref: > users.user_id]
  cancellation_reason varchar(1000)
  cancelled_at timestamp
  confirmed_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (order_channel, merchant_store_reference, external_order_reference) [unique]
    (brand_id, order_date, order_number) [unique]
    (brand_id, created_at)
  }
}

Table order_daily_counters {
  brand_id uuid [not null, ref: > brands.brand_id]
  order_date date [not null]
  last_number integer [not null, note: 'Positive; allocated atomically with draft creation.']
  indexes {
    (brand_id, order_date) [pk]
  }
}

// Stores the individual sellable items, quantities, and confirmed unit prices within an order.
// Snapshots the active recipe version (applied_recipe_id) upon confirmation so later recipe edits never alter historical orders (FR-005, FR-023, AC-18).
Table order_items {
  order_item_id uuid [pk]
  order_id uuid [not null, ref: > orders.order_id]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  applied_recipe_id uuid [ref: > recipes.recipe_id, note: 'Snapshots active recipe version at confirmation for historical integrity (AC-18)']
  item_name varchar(150) [not null]
  quantity integer [not null]
  unit_price decimal(12,2) [not null]
  notes varchar(2000)
  indexes {
    (order_id)
  }
}

// Records the specific modifiers and snapshotted add-on prices selected for an individual order line item.
// Ensures kitchen tickets reflect the exact customizations ordered by the customer (FR-002, FR-005).
Table order_item_modifiers {
  order_item_modifier_id uuid [pk]
  order_item_id uuid [not null, ref: > order_items.order_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  modifier_name varchar(150) [not null]
  additional_price decimal(12,2) [not null, default: 0]
  indexes {
    (order_item_id, modifier_id) [unique]
  }
}

// Manages the kitchen fulfillment and quality-control workflow for a confirmed order from queue to handover.
// Enforces distinct states for preparation, checker verification (CHECKING), rework on failed QC (REWORKING), READY, and final handover (FR-009, AC-06, BR-11, BR-12).
Table kitchen_tickets {
  kitchen_ticket_id uuid [pk]
  order_id uuid [not null, unique, ref: - orders.order_id]
  order_code varchar(64) [not null, note: 'Copied from the order when confirmed.']
  ticket_number varchar(64) [not null, unique]
  status kitchen_ticket_statuses [not null, default: 'QUEUED']
  preparer_id uuid [ref: > users.user_id]
  checker_id uuid [ref: > users.user_id]
  created_by_id uuid [not null, ref: > users.user_id]
  acknowledged_at timestamp
  preparation_started_at timestamp
  ready_at timestamp
  handed_over_at timestamp
  cancelled_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (status, created_at)
  }
  Note: 'Created when an order is confirmed. QC attempts and rejected portions are stored separately; state transitions are logged in audit_logs.'
}

Table handoffs {
  handoff_id uuid [pk]
  actor_id uuid [not null, ref: > users.user_id]
  kitchen_ticket_id uuid [not null, unique, ref: - kitchen_tickets.kitchen_ticket_id]
  img_keys "varchar(2048)[]" [not null, default: `'{}'`]
  created_at timestamp [not null, default: `now()`]
  indexes {
    (actor_id)
  }
}

// Each recheck creates a new attempt. A completed passing attempt needs no rejection rows.
Table kitchen_ticket_qc_attempts {
  qc_attempt_id uuid [pk]
  kitchen_ticket_id uuid [not null, ref: > kitchen_tickets.kitchen_ticket_id]
  attempt_number integer [not null, note: 'Positive; unique within the kitchen ticket.']
  status kitchen_ticket_qc_statuses [not null, default: 'IN_PROGRESS']
  checker_id uuid [not null, ref: > users.user_id]
  started_at timestamp [not null, default: `now()`]
  completed_at timestamp
  indexes {
    (kitchen_ticket_id, attempt_number) [unique]
    (checker_id)
  }
}

// One row per rejected portion per attempt. Passing portions create no rows.
Table order_item_qc_rejections {
  rejection_id uuid [pk]
  qc_attempt_id uuid [not null, ref: > kitchen_ticket_qc_attempts.qc_attempt_id]
  order_item_id uuid [not null, ref: > order_items.order_item_id]
  portion_number integer [not null, note: 'Positive; backend must validate the order item quantity bound and ticket membership.']
  rejection_reason qc_rejection_reasons [not null]
  description varchar(2000) [not null, note: 'Must contain non-whitespace text.']
  rejected_at timestamp [not null, default: `now()`]
  indexes {
    (qc_attempt_id, order_item_id, portion_number) [unique]
    (order_item_id)
  }
}

// ==========================================
// 4. AUDIT TRAIL
// ==========================================

// Provides a unified, append-only audit trail for consequential events, state transitions, order/recipe edits, and denied access attempts.
// Preserves actor identity, timestamps, reasons, and before/after JSON snapshots without permitting silent edits or deletions (FR-008, FR-030, NFR-006, AC-08, AC-17).
Table audit_logs {
  audit_log_id uuid [pk]
  actor_id uuid [ref: > users.user_id]
  action varchar(100) [not null, note: 'ORDER_CONFIRMED, TICKET_QC_FAILED, BATCH_HELD, RECIPE_VIEW_DENIED, etc.']
  entity_type varchar(64) [not null, note: 'orders, kitchen_tickets, recipes, etc.']
  entity_id uuid
  outcome audit_outcomes [not null]
  reason varchar(1000)
  before_data jsonb
  after_data jsonb
  request_id varchar(128)
  created_at timestamp [not null, default: `now()`]
  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
  }
  Note: 'Unified append-only audit history for orders, kitchen tickets, recipes and RBAC denials.'
}
