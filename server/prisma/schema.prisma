// Source: docs/erd.dbml.
// Field length policy: docs/schema-limits.md.
// Independent UUID primary keys are generated by Prisma with @default(uuid()).
// Shared primary/foreign keys and composite keys reuse the referenced IDs.
// modified_at defaults initialize values; updates remain explicit (no @updatedAt).
// Modifier/menu pairing and cross-table business rules remain backend validations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED

  @@map("audit_outcomes")
}

enum KitchenTicketStatus {
  QUEUED
  ACKNOWLEDGED
  PREPARING
  CHECKING
  FOR_CHECKING
  REWORKING
  READY
  HANDED_OVER
  CANCELLED

  @@map("kitchen_ticket_statuses")
}

enum KitchenTicketQcStatus {
  IN_PROGRESS
  PASSED
  FAILED

  @@map("kitchen_ticket_qc_statuses")
}

enum QcRejectionReason {
  INCOMPLETE

  @@map("qc_rejection_reasons")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  GRABFOOD
  FOODPANDA

  @@map("order_channels")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED

  @@map("order_statuses")
}

enum UserRole {
  SUPERADMIN
  RECIPE_MANAGER
  SUPERVISOR
  KITCHEN_HEAD
  INVENTORY_STAFF
  KITCHEN_STAFF
  CASHIER_STAFF

  @@map("user_roles")
}

enum PaymentMethod {
  CASH
  E_WALLET
  CARD
  PLATFORM_SETTLED

  @@map("payment_methods")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("payment_statuses")
}

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  username      String   @unique @db.VarChar(16)
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          UserRole
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  modified_at   DateTime @default(now()) @db.Timestamp(6)

  user_sessions_user                 UserSession[]            @relation("UserSessionUser")
  user_pin_credential                UserPinCredential?       @relation("UserPinCredentialUser")
  orders_created_by                  Order[]                  @relation("OrderCreatedBy")
  orders_cancelled_by                Order[]                  @relation("OrderCancelledBy")
  kitchen_tickets_preparer           KitchenTicket[]          @relation("KitchenTicketPreparer")
  kitchen_tickets_checker            KitchenTicket[]          @relation("KitchenTicketChecker")
  kitchen_tickets_created_by         KitchenTicket[]          @relation("KitchenTicketCreatedBy")
  kitchen_ticket_qc_attempts_checker KitchenTicketQcAttempt[] @relation("KitchenTicketQcAttemptChecker")
  handoffs_actor                     Handoff[]                @relation("HandoffActor")
  audit_logs_actor                   AuditLog[]               @relation("AuditLogActor")

  @@map("users")
}

/// One optional PIN credential per user. Never store or return the plaintext PIN.
/// Missing credentials mean the user has not configured a PIN.
/// Plaintext PINs must be exactly four ASCII digits (including leading zeros), validated before hashing.
/// Hash storage length is independent of PIN length; the database cannot validate plaintext from a hash.
model UserPinCredential {
  user_id         String    @id @db.Uuid
  pin_hash        String    @db.VarChar(255)
  failed_attempts Int       @default(0)
  locked_until    DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  modified_at     DateTime  @default(now()) @db.Timestamp(6)

  user User @relation("UserPinCredentialUser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_pin_credentials")
}

/// Stores revocable sessions. The backend enforces expiration and records activity.
model UserSession {
  session_id   String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  /// SHA-256 hex digest; never store the raw bearer token
  token_hash   String   @unique @db.VarChar(64)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  expires_at   DateTime @db.Timestamp(6)
  last_seen_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation("UserSessionUser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@map("user_sessions")
}

model Brand {
  brand_id    String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.Char(4)
  name        String   @db.VarChar(150)
  logo_url    String?  @db.VarChar(2048)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  modified_at DateTime @default(now()) @db.Timestamp(6)
  is_active   Boolean  @default(true)

  orders_brand               Order[]             @relation("OrderBrand")
  menu_items_brand           MenuItem[]          @relation("MenuItemBrand")
  recipes_brand              Recipe[]            @relation("RecipeBrand")
  order_daily_counters_brand OrderDailyCounter[] @relation("OrderDailyCounterBrand")

  @@map("brands")
}

model Order {
  order_id                 String         @id @default(uuid()) @db.Uuid
  /// Saved brand prefix and daily number; repeats on different Manila dates.
  order_code               String         @db.VarChar(64)
  order_date               DateTime       @db.Date
  order_number             Int
  create_request_hash      String?        @db.VarChar(64)
  brand_id                 String         @db.Uuid
  created_by_id            String         @db.Uuid
  order_channel            OrderChannel
  /// Stable platform store ID or configured store code; null for internal orders
  merchant_store_reference String?        @db.VarChar(255)
  /// Platform order ID; null for internal orders
  external_order_reference String?        @db.VarChar(255)
  table_reference          String?        @db.VarChar(50)
  status                   OrderStatus    @default(DRAFT)
  /// Null while DRAFT; set upon confirmation or payment
  payment_method           PaymentMethod?
  payment_status           PaymentStatus  @default(UNPAID)
  /// Optional e-wallet/card reference number
  payment_reference        String?        @db.VarChar(255)
  notes                    String?        @db.VarChar(2000)
  cancelled_by_id          String?        @db.Uuid
  cancellation_reason      String?        @db.VarChar(1000)
  cancelled_at             DateTime?      @db.Timestamp(6)
  confirmed_at             DateTime?      @db.Timestamp(6)
  completed_at             DateTime?      @db.Timestamp(6)
  created_at               DateTime       @default(now()) @db.Timestamp(6)
  modified_at              DateTime       @default(now()) @db.Timestamp(6)

  brand                 Brand          @relation("OrderBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  created_by            User           @relation("OrderCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  cancelled_by          User?          @relation("OrderCancelledBy", fields: [cancelled_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  order_items_order     OrderItem[]    @relation("OrderItemOrder")
  kitchen_tickets_order KitchenTicket? @relation("KitchenTicketOrder")

  @@unique([order_channel, merchant_store_reference, external_order_reference])
  @@unique([brand_id, order_date, order_number])
  @@index([brand_id, created_at])
  @@map("orders")
}

model OrderDailyCounter {
  brand_id    String   @db.Uuid
  order_date  DateTime @db.Date
  last_number Int

  brand Brand @relation("OrderDailyCounterBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([brand_id, order_date])
  @@map("order_daily_counters")
}

model OrderItem {
  order_item_id     String  @id @default(uuid()) @db.Uuid
  order_id          String  @db.Uuid
  menu_item_id      String  @db.Uuid
  /// Snapshots active recipe version at confirmation for historical BOM integrity
  applied_recipe_id String? @db.Uuid
  /// Immutable confirmation contents; restricted instructions are not returned by the Order API.
  recipe_snapshot   Json?   @db.JsonB
  item_name         String  @db.VarChar(150)
  quantity          Int
  unit_price        Decimal @db.Decimal(12, 2)
  notes             String? @db.VarChar(2000)

  order                           Order                  @relation("OrderItemOrder", fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  menu_item                       MenuItem               @relation("OrderItemMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  applied_recipe                  Recipe?                @relation("OrderItemAppliedRecipe", fields: [applied_recipe_id], references: [recipe_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_modifiers_order_item OrderItemModifier[]    @relation("OrderItemModifierOrderItem")
  qc_rejections                   OrderItemQcRejection[] @relation("OrderItemQcRejectionOrderItem")

  @@index([order_id])
  @@map("order_items")
}

model OrderItemModifier {
  order_item_modifier_id String  @id @default(uuid()) @db.Uuid
  order_item_id          String  @db.Uuid
  modifier_id            String  @db.Uuid
  modifier_name          String  @db.VarChar(150)
  additional_price       Decimal @default(0) @db.Decimal(12, 2)

  order_item OrderItem @relation("OrderItemModifierOrderItem", fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  modifier   Modifier  @relation("OrderItemModifierModifier", fields: [modifier_id], references: [modifier_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_item_id, modifier_id])
  @@map("order_item_modifiers")
}

model MenuItem {
  menu_item_id        String   @id @default(uuid()) @db.Uuid
  brand_id            String   @db.Uuid
  recipe_id           String   @db.Uuid
  img_url             String   @db.VarChar(2048)
  code                String   @unique @db.VarChar(64)
  name                String   @db.VarChar(150)
  description         String?  @db.VarChar(2000)
  serving_description String?  @db.VarChar(255)
  base_price          Decimal  @db.Decimal(12, 2)
  is_available        Boolean  @default(true)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  modified_at         DateTime @default(now()) @db.Timestamp(6)

  brand                         Brand              @relation("MenuItemBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  recipe                        Recipe             @relation("MenuItemRecipe", fields: [recipe_id], references: [recipe_id], onDelete: NoAction, onUpdate: NoAction)
  order_items_menu_item         OrderItem[]        @relation("OrderItemMenuItem")
  menu_item_modifiers_menu_item MenuItemModifier[] @relation("MenuItemModifierMenuItem")
  menu_item_channels_menu_item  MenuItemChannel[]  @relation("MenuItemChannelMenuItem")

  @@index([brand_id, is_active])
  @@map("menu_items")
}

/// Channel-specific price and availability overrides.
model MenuItemChannel {
  menu_item_channel_id String       @id @default(uuid()) @db.Uuid
  menu_item_id         String       @db.Uuid
  order_channel        OrderChannel
  price                Decimal      @db.Decimal(12, 2)
  is_available         Boolean      @default(true)
  created_at           DateTime     @default(now()) @db.Timestamp(6)
  modified_at          DateTime     @default(now()) @db.Timestamp(6)

  menu_item MenuItem @relation("MenuItemChannelMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([menu_item_id, order_channel])
  @@map("menu_item_channels")
}

model Modifier {
  modifier_id String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(2000)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  modified_at DateTime @default(now()) @db.Timestamp(6)

  order_item_modifiers_modifier OrderItemModifier[] @relation("OrderItemModifierModifier")
  menu_item_modifiers_modifier  MenuItemModifier[]  @relation("MenuItemModifierModifier")

  @@map("modifiers")
}

model MenuItemModifier {
  menu_item_modifier_id String   @id @default(uuid()) @db.Uuid
  menu_item_id          String   @db.Uuid
  modifier_id           String   @db.Uuid
  additional_price      Decimal  @default(0) @db.Decimal(12, 2)
  is_available          Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  modified_at           DateTime @default(now()) @db.Timestamp(6)

  menu_item MenuItem @relation("MenuItemModifierMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  modifier  Modifier @relation("MenuItemModifierModifier", fields: [modifier_id], references: [modifier_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([menu_item_id, modifier_id])
  @@map("menu_item_modifiers")
}

/// Brand-owned; employees operate across brands subject to recipe access rules.
model Recipe {
  recipe_id           String   @id @default(uuid()) @db.Uuid
  brand_id            String   @db.Uuid
  code                String   @db.VarChar(64)
  name                String   @db.VarChar(150)
  serving_description String?  @db.VarChar(255)
  /// Restricted field; exclude from unauthorized API responses
  instructions        String?  @db.VarChar(10000)
  notes               String?  @db.VarChar(2000)
  version             Int      @default(1)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  modified_at         DateTime @default(now()) @db.Timestamp(6)

  brand                      Brand       @relation("RecipeBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  menu_items_recipe          MenuItem[]  @relation("MenuItemRecipe")
  order_items_applied_recipe OrderItem[] @relation("OrderItemAppliedRecipe")

  @@unique([code, version])
  @@index([brand_id, is_active])
  @@map("recipes")
}

/// Created when an order is confirmed. Ticket contents come from order_items and order_item_modifiers.
model KitchenTicket {
  kitchen_ticket_id      String              @id @default(uuid()) @db.Uuid
  order_id               String              @unique @db.Uuid
  order_code             String              @db.VarChar(64)
  /// T- plus a running number, minimum 3 digits; may grow beyond T-99999 (64 characters maximum).
  ticket_number          String              @unique @db.VarChar(64)
  status                 KitchenTicketStatus @default(QUEUED)
  preparer_id            String?             @db.Uuid
  checker_id             String?             @db.Uuid
  created_by_id          String              @db.Uuid
  acknowledged_at        DateTime?           @db.Timestamp(6)
  preparation_started_at DateTime?           @db.Timestamp(6)
  ready_at               DateTime?           @db.Timestamp(6)
  handed_over_at         DateTime?           @db.Timestamp(6)
  cancelled_at           DateTime?           @db.Timestamp(6)
  notes                  String?             @db.VarChar(2000)
  created_at             DateTime            @default(now()) @db.Timestamp(6)
  modified_at            DateTime            @default(now()) @db.Timestamp(6)

  order       Order                    @relation("KitchenTicketOrder", fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  preparer    User?                    @relation("KitchenTicketPreparer", fields: [preparer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  checker     User?                    @relation("KitchenTicketChecker", fields: [checker_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  created_by  User                     @relation("KitchenTicketCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  qc_attempts KitchenTicketQcAttempt[] @relation("KitchenTicketQcAttemptKitchenTicket")
  handoff     Handoff?                 @relation("HandoffKitchenTicket")

  @@index([status, created_at])
  @@map("kitchen_tickets")
}

model Handoff {
  handoff_id        String   @id @default(uuid()) @db.Uuid
  actor_id          String   @db.Uuid
  kitchen_ticket_id String   @unique @db.Uuid
  img_keys          String[] @default([]) @db.VarChar(2048)
  created_at        DateTime @default(now()) @db.Timestamp(6)

  actor          User          @relation("HandoffActor", fields: [actor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  kitchen_ticket KitchenTicket @relation("HandoffKitchenTicket", fields: [kitchen_ticket_id], references: [kitchen_ticket_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id])
  @@map("handoffs")
}

/// Each recheck creates a new attempt; completing QC does not require rows for passed portions.
model KitchenTicketQcAttempt {
  qc_attempt_id     String                @id @default(uuid()) @db.Uuid
  kitchen_ticket_id String                @db.Uuid
  attempt_number    Int
  status            KitchenTicketQcStatus @default(IN_PROGRESS)
  checker_id        String                @db.Uuid
  started_at        DateTime              @default(now()) @db.Timestamp(6)
  completed_at      DateTime?             @db.Timestamp(6)

  kitchen_ticket KitchenTicket          @relation("KitchenTicketQcAttemptKitchenTicket", fields: [kitchen_ticket_id], references: [kitchen_ticket_id], onDelete: NoAction, onUpdate: NoAction)
  checker        User                   @relation("KitchenTicketQcAttemptChecker", fields: [checker_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  rejections     OrderItemQcRejection[] @relation("OrderItemQcRejectionQcAttempt")

  @@unique([kitchen_ticket_id, attempt_number])
  @@index([checker_id])
  @@map("kitchen_ticket_qc_attempts")
}

/// Rejected portions only. Ticket membership and portion_number <= order item quantity require backend validation.
model OrderItemQcRejection {
  rejection_id     String            @id @default(uuid()) @db.Uuid
  qc_attempt_id    String            @db.Uuid
  order_item_id    String            @db.Uuid
  portion_number   Int
  rejection_reason QcRejectionReason
  description      String            @db.VarChar(2000)
  rejected_at      DateTime          @default(now()) @db.Timestamp(6)

  qc_attempt KitchenTicketQcAttempt @relation("OrderItemQcRejectionQcAttempt", fields: [qc_attempt_id], references: [qc_attempt_id], onDelete: NoAction, onUpdate: NoAction)
  order_item OrderItem              @relation("OrderItemQcRejectionOrderItem", fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([qc_attempt_id, order_item_id, portion_number])
  @@index([order_item_id])
  @@map("order_item_qc_rejections")
}

/// Append-only audit history. Actor may be null for system or unauthenticated actions. Exclude passwords, tokens and restricted recipe instructions from snapshots.
model AuditLog {
  audit_log_id String       @id @default(uuid()) @db.Uuid
  actor_id     String?      @db.Uuid
  /// RECIPE_UPDATED, USER_CREATED, etc.
  action       String       @db.VarChar(100)
  /// recipes, users, stock_adjustments, etc.
  entity_type  String       @db.VarChar(64)
  entity_id    String?      @db.Uuid
  outcome      AuditOutcome
  reason       String?      @db.VarChar(1000)
  before_data  Json?        @db.JsonB
  after_data   Json?        @db.JsonB
  request_id   String?      @db.VarChar(128)
  created_at   DateTime     @default(now()) @db.Timestamp(6)

  actor User? @relation("AuditLogActor", fields: [actor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_id, created_at])
  @@map("audit_logs")
}
